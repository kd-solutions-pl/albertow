#!/bin/sh
set -eu

pwdfile="@ADMIN_USER_PWDFILE@"

read_secret() {
    prompt="$1"

    if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
        printf 'Password prompt requires a controlling terminal.\n' >&2
        exit 1
    fi

    oldstty="$(stty -g < /dev/tty)"
    trap 'stty "$oldstty" < /dev/tty; printf "\n" > /dev/tty; exit 130' INT TERM HUP

    printf '%s' "$prompt" > /dev/tty
    stty -echo < /dev/tty
    if ! IFS= read -r secret < /dev/tty; then
        stty "$oldstty" < /dev/tty
        trap - INT TERM HUP
        printf '\n' > /dev/tty
        printf 'Failed to read password.\n' >&2
        exit 1
    fi
    stty "$oldstty" < /dev/tty
    trap - INT TERM HUP
    printf '\n' > /dev/tty

    printf '%s' "$secret"
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != "--stdin" ]; }; then
    printf 'Usage: %s USER [--stdin]\n' "$0" >&2
    exit 2
fi

user="$1"
if [ "$#" -eq 2 ]; then
    IFS= read -r password || {
        printf 'Failed to read password from stdin.\n' >&2
        exit 1
    }
else
    password="$(read_secret 'New password: ')"
    password_confirm="$(read_secret 'Retype new password: ')"
    if [ "$password" != "$password_confirm" ]; then
        printf 'Passwords do not match.\n' >&2
        exit 1
    fi
fi
tmp="${pwdfile}.$$"

if [ -z "$password" ]; then
    printf 'Password must not be empty.\n' >&2
    exit 1
fi

if ! awk -F: -v user="$user" '$1 == user { found = 1 } END { exit !found }' /etc/passwd; then
    printf 'User does not exist: %s\n' "$user" >&2
    exit 1
fi

mkdir -p "$(dirname "$pwdfile")"
chmod 0700 "$(dirname "$pwdfile")"

hash="$(printf '%s\n' "$password" | /usr/bin/mkpasswd --stdin --method=yescrypt)"
printf '%s:%s\n' "$user" "$hash" > "$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$pwdfile"
